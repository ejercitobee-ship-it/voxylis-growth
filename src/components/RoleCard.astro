---
import type { Role } from '../data/services';
interface Props { role: Role; contactHref: string; }
const { role, contactHref } = Astro.props;
---
<div class="card role-card reveal">
  <h3>{role.title}</h3>
  <p>{role.description}</p>
  <ul>
    {role.responsibilities.map((r) => (
      <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>{r}</li>
    ))}
  </ul>
  <div class="engage">{role.engagement}</div>
  <a class="role-cta" href={contactHref}>Discuss this role
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px;margin-left:3px"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
  </a>
</div>
