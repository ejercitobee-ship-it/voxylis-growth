---
import Button from './Button.astro';
interface Props {
  heading?: string;
  text?: string;
  cta?: string;
  href?: string;
  eyebrow?: string;
}
const {
  heading = "Let's build the right team for your business.",
  text = "Tell us where your business needs support. We'll discuss your priorities and explore a team structure that fits.",
  cta = 'Book a Consultation',
  href = '/contact/',
  eyebrow = '',
} = Astro.props;
---
<section class="cta-band">
  <div class="wrap">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h2>{heading}</h2>
    <p>{text}</p>
    <Button href={href} variant="on-dark" arrow>{cta}</Button>
  </div>
</section>
