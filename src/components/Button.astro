---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost' | 'on-dark' | 'ghost-dark';
  arrow?: boolean;
  class?: string;
}
const { href, variant = 'primary', arrow = false, class: cls = '' } = Astro.props;
const variantClass: Record<string, string> = {
  primary: 'btn-primary',
  ghost: 'btn-ghost',
  'on-dark': 'btn-on-dark',
  'ghost-dark': 'btn-ghost-dark',
};
---
<a href={href} class:list={['btn', variantClass[variant], cls]}>
  <slot />
  {arrow && (
    <span class="arrow"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
  )}
</a>
