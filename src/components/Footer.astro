---
import { footerNav } from '../data/nav';
import { company } from '../data/company';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div>
        <a href="/" class="brand" aria-label="Voxylis Growth home">
          <svg class="mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect width="32" height="32" rx="6" fill="#B99662"></rect>
            <path d="M9 10.5l7 11 7-11" stroke="#0b2219" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          Voxylis Growth
        </a>
        <p class="footer-tag">A growth consulting partner helping US and UK businesses grow with focus and measurable results.</p>
        <p class="footer-contact">
          <a href={company.phoneHref}>{company.phoneDisplay}</a><br />
          <a href={`mailto:${company.email}`}>{company.email}</a>
        </p>
      </div>
      {footerNav.map((col) => (
        <div class="footer-col">
          <p class="footer-col-h">{col.heading}</p>
          <ul>
            {col.links.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="footer-bottom">
      <span>&copy; {company.year} {company.legalName}. All rights reserved.</span>
      <span>Growth consulting for businesses across the US and UK.</span>
    </div>
  </div>
</footer>
