---
import type { Category } from '../data/services';
interface Props { cat: Category; }
const { cat } = Astro.props;
const imgMap: Record<string, string> = {
  'customer-experience': 'cx',
  'executive-admin': 'admin',
  sales: 'sales',
  marketing: 'marketing',
  technical: 'tech',
  'business-ecommerce': 'ecom',
};
const img = `/img/svc-${imgMap[cat.slug] ?? 'cx'}.jpg`;
---
<a href={`/services/${cat.slug}/`} class="svc-card reveal">
  <div class="svc-photo"><img src={img} width="900" height="560" alt={`${cat.title} professionals at work`} loading="lazy" /></div>
  <div class="svc-body">
    <h3>{cat.title}</h3>
    <p>{cat.short}</p>
    <span class="card-link">Read more <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
  </div>
</a>
