---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { company } from '../data/company';
---
<Base
  title="Book a Consultation | Contact Voxylis Growth"
  description="Tell us your growth goals and we will prepare a tailored proposal. Growth consulting for US and UK businesses."
>
  <section>
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow" style="display:block;margin-bottom:0.8rem">Book a Consultation</span>
        <h1 style="font-size:clamp(2rem,4.5vw,3rem)">Let's find your next stage of growth.</h1>
        <p>Tell us about your business and where growth feels stuck. We will come back within one business day with next steps and, where it fits, a tailored proposal.</p>
      </div>
      <div class="contact-grid" style="margin-top:2.8rem">
        <aside class="contact-aside reveal">
          <div class="ca-item">
            <div class="k">Call or text</div>
            <div class="v"><a href={company.phoneHref}>{company.phoneDisplay}</a></div>
          </div>
          <div class="ca-item">
            <div class="k">Email</div>
            <div class="v"><a href={`mailto:${company.email}`}>{company.email}</a></div>
          </div>
          <div class="ca-item">
            <div class="k">What to expect</div>
            <p class="muted" style="font-size:0.95rem;margin-top:0.4rem">A short discovery conversation, a clear read on where to focus, and a proposal shaped around your goals and priorities. No pressure and no obligation.</p>
          </div>
        </aside>
        <div class="reveal">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</Base>
