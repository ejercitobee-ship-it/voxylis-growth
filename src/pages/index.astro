---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import ServiceCard from '../components/ServiceCard.astro';
import IndustryCard from '../components/IndustryCard.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CtaBand from '../components/CtaBand.astro';
import { categories } from '../data/services';
import { industries } from '../data/industries';

const values = [
  { t: 'Focus Over Noise', b: 'We find the few moves that will actually move the needle, instead of a long list of everything you could do.', i: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>' },
  { t: 'Strategy and Execution', b: 'We do not just hand over a deck. We work alongside your team to put the plan into motion.', i: '<path d="M12 3l8 3v5c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/>' },
  { t: 'Decisions Backed by Data', b: 'We agree on the numbers that matter and track them, so progress is measured, not guessed.', i: '<path d="M3 3v18h18"/><rect x="7" y="10" width="3" height="7"/><rect x="12" y="6" width="3" height="11"/><rect x="17" y="13" width="3" height="4"/>' },
  { t: 'Built for US & UK Businesses', b: 'An outside partner who understands growing US and UK companies and works the way you do.', i: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/>' },
  { t: 'Start Focused, Scale Up', b: 'Begin with a single project and expand into an ongoing partnership once you see how we work.', i: '<path d="M12 3l8 4-8 4-8-4 8-4z"/><path d="M4 12l8 4 8-4M4 17l8 4 8-4"/>' },
];

const principles = [
  { t: 'We start with the whole business', b: 'Before tactics, we look at where growth is really stuck, so the plan fixes causes, not symptoms.' },
  { t: 'We prioritize ruthlessly', b: 'A short list of high-impact moves beats a long list of good intentions. We help you choose.' },
  { t: 'We stay for the execution', b: 'Plans only matter when they ship. We work alongside your team to make the priorities happen.' },
  { t: 'We measure and adjust', b: 'We agree the metrics up front, review them on a regular cadence, and change course as we learn.' },
];
---
<Base
  title="Voxylis Growth | Growth Consulting for US & UK Businesses"
  description="Voxylis Growth is a growth consulting firm that helps US and UK businesses turn ambition into a clear plan and measurable results across strategy, marketing, sales, and operations."
>
  <!-- A. Hero -->
  <section class="hero hero-bg">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Growth Consulting</span>
        <h1>Clear Strategy. Real Business Growth.</h1>
        <p class="lead">Voxylis Growth helps US and UK businesses turn ambition into a focused plan and measurable results, across strategy, marketing, sales, and operations.</p>
        <div class="hero-ctas">
          <Button href="/contact/" variant="primary" arrow>Book a Consultation</Button>
          <a href="/services/" class="textlink">Explore our services <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
      </div>
    </div>
  </section>

  <!-- B. Value proposition -->
  <section class="band">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">Why Voxylis Growth</span>
        <h2>A growth partner, built for serious businesses.</h2>
      </div>
      <div class="grid cols-3" style="margin-top:2.8rem">
        {values.map((v) => (
          <div class="feat reveal">
            <span class="fico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={v.i}></svg></span>
            <div><h3>{v.t}</h3><p>{v.b}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- C. Services -->
  <section class="band-dark">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">Services</span>
        <h2>Where We Drive Growth.</h2>
        <p>Six areas where the right focus turns effort into momentum. Most engagements combine a few of them.</p>
      </div>
      <div class="grid cols-3" style="margin-top:2.8rem">
        {categories.map((c) => <ServiceCard cat={c} />)}
      </div>
    </div>
  </section>

  <!-- D. How it works -->
  <section>
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">How It Works</span>
        <h2>A Clear Path from Goal to Growth.</h2>
      </div>
      <div style="margin-top:2.8rem"><ProcessSteps /></div>
      <div class="reveal" style="text-align:center;margin-top:2.6rem">
        <Button href="/how-it-works/" variant="ghost" arrow>See the full process</Button>
      </div>
    </div>
  </section>

  <!-- E. Industries -->
  <section class="band">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">Industries</span>
        <h2>Different Industries. Shared Commitment to Excellence.</h2>
      </div>
      <div class="grid cols-3" style="margin-top:2.8rem">
        {industries.map((i) => <IndustryCard ind={i} />)}
      </div>
    </div>
  </section>

  <!-- F. Why Voxylis -->
  <section>
    <div class="wrap split">
      <div class="split-img reveal">
        <img src="/img/why.jpg" width="1200" height="1200" alt="A professional reviewing growth plans in a bright modern office" loading="lazy" />
      </div>
      <div class="reveal">
        <span class="eyebrow">A Real Partnership</span>
        <h2 style="font-size:clamp(1.9rem,4vw,2.7rem);margin-top:0.9rem">More Than Advice.</h2>
        <p class="muted" style="margin:1rem 0 1.8rem;font-size:1.03rem;max-width:52ch">A report that sits in a drawer changes nothing. We bring the plan and then stay to help you run it, so the strategy actually turns into growth.</p>
        {principles.map((p, idx) => (
          <div class="principle">
            <span class="pn">0{idx + 1}</span>
            <div><h3>{p.t}</h3><p>{p.b}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- G. Proof / credibility (honest) -->
  <section class="band">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">Our Approach</span>
        <h2>Honest Work. Focused on Your Goals.</h2>
        <p>We are building Voxylis Growth on real, verifiable results. Rather than borrowed logos or invented numbers, here is exactly how we earn trust from day one.</p>
      </div>
      <div class="grid cols-3" style="margin-top:2.6rem">
        <div class="card reveal"><h3 style="font-size:1.2rem">We diagnose before we prescribe</h3><p class="muted" style="margin-top:0.5rem;font-size:0.95rem">Every engagement starts by understanding your goals and numbers, so the plan fixes the real constraint.</p></div>
        <div class="card reveal"><h3 style="font-size:1.2rem">We set goals we can measure</h3><p class="muted" style="margin-top:0.5rem;font-size:0.95rem">We agree the metrics that matter up front and track them, so progress is clear and honest.</p></div>
        <div class="card reveal"><h3 style="font-size:1.2rem">We let the work speak</h3><p class="muted" style="margin-top:0.5rem;font-size:0.95rem">No invented testimonials or results. Verified case studies will live here as engagements complete.</p></div>
      </div>
    </div>
  </section>

  <!-- H. Consultation CTA -->
  <CtaBand eyebrow="Book a Consultation" heading="Let's Find Your Next Stage of Growth." text="Tell us where your business is trying to go and what is getting in the way. We'll talk through your priorities and where we can help most." cta="Book a Consultation" />
</Base>
