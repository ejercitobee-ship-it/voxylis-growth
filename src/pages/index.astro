---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import ServiceCard from '../components/ServiceCard.astro';
import IndustryCard from '../components/IndustryCard.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CtaBand from '../components/CtaBand.astro';
import { categories } from '../data/services';
import { industries } from '../data/industries';

const values = [
  { t: 'Skilled Filipino Talent', b: 'Experienced professionals selected for relevant skills, communication, and professionalism.', i: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M16 11l2 2 4-4"/>' },
  { t: 'Managed Team Support', b: 'More than a hire. Structured onboarding and ongoing oversight are part of the service.', i: '<path d="M12 3l8 3v5c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/>' },
  { t: 'Role-Specific Expertise', b: 'People matched to clearly defined roles, not interchangeable generalists.', i: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.4"/>' },
  { t: 'US & UK Business Alignment', b: 'Coverage and communication built around your business hours and standards.', i: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/>' },
  { t: 'Flexible Team Structure', b: 'Start with one role and expand as your needs and budget grow.', i: '<path d="M12 3l8 4-8 4-8-4 8-4z"/><path d="M4 12l8 4 8-4M4 17l8 4 8-4"/>' },
];

const principles = [
  { t: 'The right people for clearly defined roles', b: 'We match experienced professionals to real responsibilities, not a generic task list.' },
  { t: 'Workflows aligned with your business', b: 'We help document and set up the processes the role runs on, inside your tools.' },
  { t: 'Structured communication and accountability', b: 'Clear check-ins, reviews, and a straightforward way to raise anything that needs attention.' },
  { t: 'A flexible approach to changing needs', b: 'As your business shifts, we adjust responsibilities, coverage, and scope with you.' },
];
---
<Base
  title="Voxylis Growth | Managed Outsourcing & Skilled Filipino Professionals"
  description="Voxylis Growth connects US and UK businesses with skilled Filipino professionals through a managed outsourcing model built around your goals, workflows, and operational needs."
>
  <!-- A. Hero -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Filipino Managed Outsourcing</span>
        <h1>World-Class Talent. Real Business Growth.</h1>
        <p class="lead">Voxylis Growth connects businesses with skilled Filipino professionals through a managed outsourcing model built around your goals, workflows, and operational needs.</p>
        <div class="hero-ctas">
          <Button href="/contact/" variant="primary" arrow>Book a Consultation</Button>
          <a href="/services/" class="textlink">Explore our services <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
      </div>
      <div class="hero-visual">
        <img src="/img/hero.jpg" width="1600" height="1067" alt="A team of professionals collaborating in a modern office" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- B. Value proposition -->
  <section class="band">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">Why Voxylis Growth</span>
        <h2>A managed partner, built for serious businesses.</h2>
      </div>
      <div class="grid cols-3" style="margin-top:2.8rem">
        {values.map((v) => (
          <div class="feat reveal">
            <span class="fico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={v.i}></svg></span>
            <div><h3>{v.t}</h3><p>{v.b}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- C. Services -->
  <section class="band-dark">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">Services</span>
        <h2>Specialized Roles. Real Impact.</h2>
        <p>Find the right expertise for the work that moves your business forward.</p>
      </div>
      <div class="grid cols-3" style="margin-top:2.8rem">
        {categories.map((c) => <ServiceCard cat={c} />)}
      </div>
    </div>
  </section>

  <!-- D. How it works -->
  <section>
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">How It Works</span>
        <h2>A Better Way to Build Your Team.</h2>
      </div>
      <div style="margin-top:2.8rem"><ProcessSteps /></div>
      <div class="reveal" style="text-align:center;margin-top:2.6rem">
        <Button href="/how-it-works/" variant="ghost" arrow>See the full process</Button>
      </div>
    </div>
  </section>

  <!-- E. Industries -->
  <section class="band">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">Industries</span>
        <h2>Different Industries. Shared Commitment to Excellence.</h2>
      </div>
      <div class="grid cols-3" style="margin-top:2.8rem">
        {industries.map((i) => <IndustryCard ind={i} />)}
      </div>
    </div>
  </section>

  <!-- F. Why Voxylis -->
  <section>
    <div class="wrap split">
      <div class="split-img reveal">
        <img src="/img/why.jpg" width="1200" height="1200" alt="An experienced professional working in a bright modern office" loading="lazy" />
      </div>
      <div class="reveal">
        <span class="eyebrow">A Managed Partnership</span>
        <h2 style="font-size:clamp(1.9rem,4vw,2.7rem);margin-top:0.9rem">More Than Staffing.</h2>
        <p class="muted" style="margin:1rem 0 1.8rem;font-size:1.03rem;max-width:52ch">Hiring an individual freelancer leaves the structure to you. A managed partnership brings the structure with the person, so the work actually holds together.</p>
        {principles.map((p, idx) => (
          <div class="principle">
            <span class="pn">0{idx + 1}</span>
            <div><h3>{p.t}</h3><p>{p.b}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- G. Proof / credibility (honest) -->
  <section class="band">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">Our Approach</span>
        <h2>Built Around Your Business. Focused on Your Goals.</h2>
        <p>We are building Voxylis Growth on real, verifiable work. Rather than borrowed logos or invented numbers, here is exactly how we earn trust from day one.</p>
      </div>
      <div class="grid cols-3" style="margin-top:2.6rem">
        <div class="card reveal"><h3 style="font-size:1.2rem">We scope before we staff</h3><p class="muted" style="margin-top:0.5rem;font-size:0.95rem">Every engagement starts by understanding your goals and workflows, so the role fits the work.</p></div>
        <div class="card reveal"><h3 style="font-size:1.2rem">We onboard into your world</h3><p class="muted" style="margin-top:0.5rem;font-size:0.95rem">Structured onboarding sets up responsibilities, access, and documented procedures from the start.</p></div>
        <div class="card reveal"><h3 style="font-size:1.2rem">We review and improve</h3><p class="muted" style="margin-top:0.5rem;font-size:0.95rem">Ongoing check-ins and reviews keep quality high, and verified case studies will live here as engagements complete.</p></div>
      </div>
    </div>
  </section>

  <!-- H. Consultation CTA -->
  <CtaBand eyebrow="Book a Consultation" heading="Let's Build the Right Team for Your Business." text="Tell us where your business needs support. We'll discuss your priorities and explore a team structure that fits." cta="Book a Consultation" />
</Base>
