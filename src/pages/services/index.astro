---
import Base from '../../layouts/Base.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { categories } from '../../data/services';

const models = [
  { t: 'Advisory', b: 'We build the plan and guide your team to run it, with regular reviews to keep it on track.' },
  { t: 'Hands-on', b: 'We work inside the business to put the plan in motion, alongside the people you already have.' },
  { t: 'Project or ongoing', b: 'Start with a focused project like a growth audit, then expand into an ongoing partnership as it makes sense.' },
];
---
<Base
  title="Growth Consulting Services | Voxylis Growth"
  description="Growth consulting across strategy, marketing, sales, operations, analytics, and digital, for growing US and UK businesses."
>
  <section class="band-dark">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow" style="display:block;margin-bottom:0.8rem">Services</span>
        <h1 style="font-size:clamp(2rem,4.5vw,3rem)">Focused Help, Where Growth Happens.</h1>
        <p>Six areas where the right focus turns effort into momentum. Every engagement is scoped with you, and most combine a few of these to fit what your business actually needs.</p>
      </div>
      <div class="grid cols-3" style="margin-top:2.8rem">
        {categories.map((c) => <ServiceCard cat={c} />)}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="sec-head center reveal">
        <h2>Three ways to work with us.</h2>
        <p>Different businesses need different kinds of help. We agree which fits before we begin.</p>
      </div>
      <div class="grid cols-3" style="margin-top:2.6rem">
        {models.map((m) => (
          <div class="card reveal">
            <h3 style="font-size:1.25rem">{m.t}</h3>
            <p class="muted" style="margin-top:0.5rem;font-size:0.96rem">{m.b}</p>
          </div>
        ))}
      </div>
      <p class="muted reveal" style="max-width:70ch;margin:2.2rem auto 0;text-align:center;font-size:0.95rem">
        Scope and deliverables are agreed per engagement. We do not promise specific revenue figures or guaranteed outcomes. We define exactly what is included, and the metrics we will track, before we begin.
      </p>
    </div>
  </section>

  <CtaBand heading="Not sure where to focus?" text="Tell us about your business and where growth feels stuck. We will help you find the few moves that matter most." cta="Book a Consultation" />
</Base>
