---
import Base from '../../layouts/Base.astro';
import RoleCard from '../../components/RoleCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Button from '../../components/Button.astro';
import { categories } from '../../data/services';

export function getStaticPaths() {
  return categories.map((cat) => ({ params: { category: cat.slug }, props: { cat } }));
}
const { cat } = Astro.props;
const others = categories.filter((c) => c.slug !== cat.slug);
const contactHref = `/contact/?service=${encodeURIComponent(cat.title)}`;
---
<Base
  title={`${cat.title} | Voxylis Growth`}
  description={`${cat.short} Growth consulting for US and UK businesses, scoped around your goals.`}
>
  <section>
    <div class="wrap">
      <p class="muted reveal" style="font-size:0.9rem"><a href="/services/">Services</a> &nbsp;/&nbsp; {cat.title}</p>
      <div class="sec-head reveal" style="margin-top:0.9rem">
        <span class="eyebrow" style="display:block;margin-bottom:0.8rem">Service</span>
        <h1 style="font-size:clamp(2rem,4.5vw,3rem)">{cat.title}</h1>
        <p>{cat.intro}</p>
      </div>
      <div class="hero-ctas reveal" style="margin-top:1.8rem">
        <Button href={contactHref} variant="primary" arrow>Book a Consultation</Button>
        <Button href="/how-it-works/" variant="ghost">How it works</Button>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2>What this includes.</h2>
        <p>Typical ways we help with {cat.title.toLowerCase()}. Each is scoped with you to fit your goals and stage.</p>
      </div>
      <div class="grid cols-3" style="margin-top:2.6rem">
        {cat.roles.map((role) => <RoleCard role={role} contactHref={contactHref} />)}
      </div>
      <p class="muted reveal" style="max-width:70ch;margin-top:2rem;font-size:0.95rem">{cat.caveat}</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head reveal"><h2 style="font-size:1.5rem">Other services</h2></div>
      <div class="pills reveal" style="margin-top:1.4rem">
        {others.map((c) => <a class="pill" href={`/services/${c.slug}/`}>{c.title}</a>)}
      </div>
    </div>
  </section>

  <CtaBand heading={`Want help with ${cat.title.toLowerCase()}?`} text="Tell us your goal and what is getting in the way. We will put together a proposal shaped around scope and impact." cta="Book a Consultation" href={contactHref} />
</Base>
