---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { journey, clientResponsibilities } from '../data/process';
---
<Base
  title="How It Works | Voxylis Growth"
  description="From discovery call to an onboarded professional working inside your business. See the full Voxylis Growth process and what each engagement involves."
>
  <section>
    <div class="wrap">
      <div class="sec-head reveal">
        <h2 style="font-size:clamp(2rem,4.5vw,3rem)">How it works.</h2>
        <p>A clear path from first conversation to a professional contributing inside your business, with the structure that keeps the engagement working.</p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="timeline" style="margin-inline:auto">
        {journey.map((s) => (
          <div class="tl-item reveal">
            <div class="tl-n">{s.n}</div>
            <div class="tl-body">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="grid cols-2" style="gap:clamp(28px,5vw,64px);align-items:start">
        <div class="prose reveal">
          <h2>What we handle.</h2>
          <p>We lead the sourcing, evaluation, onboarding, and ongoing oversight. We define the role with you, match experienced professionals, document the workflows, and keep communication and quality reviews going as the engagement continues.</p>
        </div>
        <div class="prose reveal">
          <h2>What we ask of you.</h2>
          <p>A successful engagement is a partnership. To get the most from your remote team, we ask clients to:</p>
          <ul>
            {clientResponsibilities.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CtaBand heading="Ready to see how this fits your business?" cta="Schedule a Discovery Call" />
</Base>
