---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { steps, clientResponsibilities } from '../data/process';
---
<Base
  title="How It Works | Voxylis Growth"
  description="A better way to build your team: Discover, Build, and Manage & Improve. See how Voxylis Growth's managed outsourcing model works end to end."
>
  <section>
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow" style="display:block;margin-bottom:0.8rem">How It Works</span>
        <h1 style="font-size:clamp(2rem,4.5vw,3rem)">A Better Way to Build Your Team.</h1>
        <p>A clear, managed path from first conversation to a professional contributing inside your business.</p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="timeline" style="margin-inline:auto">
        {steps.map((s) => (
          <div class="tl-item reveal">
            <div class="tl-n">{s.n}</div>
            <div class="tl-body">
              <p class="tl-title">{s.title}</p>
              <p>{s.long}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="split" style="gap:clamp(28px,5vw,64px);align-items:start">
        <div class="prose reveal">
          <h2>What we handle.</h2>
          <p>We lead the sourcing, evaluation, onboarding, and ongoing oversight. We define the role with you, match experienced professionals, help document the workflows, and keep communication and reviews going as the engagement continues.</p>
        </div>
        <div class="prose reveal">
          <h2>What we ask of you.</h2>
          <p>A successful engagement is a partnership. To get the most from your remote team, we ask clients to:</p>
          <ul>
            {clientResponsibilities.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CtaBand heading="Ready to see how this fits your business?" cta="Book a Consultation" />
</Base>
