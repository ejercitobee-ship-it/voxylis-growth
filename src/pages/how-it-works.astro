---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { steps, clientResponsibilities } from '../data/process';
---
<Base
  title="How It Works | Voxylis Growth"
  description="Assess, Plan, then Execute and Optimize. See how Voxylis Growth's growth consulting engagements work end to end."
>
  <section>
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow" style="display:block;margin-bottom:0.8rem">How It Works</span>
        <h1 style="font-size:clamp(2rem,4.5vw,3rem)">A Clear Path from Goal to Growth.</h1>
        <p>A straightforward path from first conversation to a focused plan in motion inside your business.</p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="timeline" style="margin-inline:auto">
        {steps.map((s) => (
          <div class="tl-item reveal">
            <div class="tl-n">{s.n}</div>
            <div class="tl-body">
              <p class="tl-title">{s.title}</p>
              <p>{s.long}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="split" style="gap:clamp(28px,5vw,64px);align-items:start">
        <div class="prose reveal">
          <h2>What we handle.</h2>
          <p>We lead the assessment, the plan, and the work of keeping it on track. We dig into your goals and numbers, identify the few priorities that matter most, help put them in motion alongside your team, and review results against the metrics we set together.</p>
        </div>
        <div class="prose reveal">
          <h2>What we ask of you.</h2>
          <p>A successful engagement is a partnership. To get the most from the work, we ask clients to:</p>
          <ul>
            {clientResponsibilities.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CtaBand heading="Ready to see how this fits your business?" cta="Book a Consultation" />
</Base>
