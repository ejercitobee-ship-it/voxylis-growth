---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';

const articles = [
  { tag: 'Strategy', title: 'How to find where your growth is really stuck', excerpt: 'A simple way to look past the symptoms and find the one or two constraints actually holding growth back.' },
  { tag: 'Prioritization', title: 'Why fewer priorities drive more growth', excerpt: 'The case for doing less, better, and a method for choosing the few moves that matter most this quarter.' },
  { tag: 'Marketing', title: 'Positioning before tactics', excerpt: 'Why a clear message beats another channel, and how to sharpen what you say before you spend.' },
  { tag: 'Sales', title: 'Turning interest into a repeatable sales process', excerpt: 'How to map the path your buyers actually take and remove the friction that stalls deals.' },
  { tag: 'Operations', title: 'Building systems so growth does not break the business', excerpt: 'The processes and tools that let you scale without everything running through the founder.' },
  { tag: 'Analytics', title: 'The handful of numbers worth watching', excerpt: 'How to choose metrics that reflect real growth, and build a reporting rhythm you will actually keep.' },
];
---
<Base
  title="Resources & Insights | Voxylis Growth"
  description="Practical thinking on growth strategy, marketing, sales, operations, and analytics for growing US and UK businesses."
>
  <section>
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow" style="display:block;margin-bottom:0.8rem">Resources</span>
        <h1 style="font-size:clamp(2rem,4.5vw,3rem)">Insights for growing with focus.</h1>
        <p>Practical thinking on growth strategy, marketing, sales, operations, and the numbers that matter. New articles are on the way.</p>
      </div>
      <div class="grid cols-3" style="margin-top:2.8rem">
        {articles.map((a) => (
          <article class="card reveal" style="display:flex;flex-direction:column;gap:0.6rem">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:0.75rem">
              <span style="font-size:0.72rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--bronze-text)">{a.tag}</span>
              <span style="font-size:0.72rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:0.4rem 0.75rem;white-space:nowrap">Coming soon</span>
            </div>
            <h2 style="font-size:1.3rem;margin-top:0.2rem">{a.title}</h2>
            <p class="muted" style="font-size:0.95rem">{a.excerpt}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand heading="Prefer to just talk it through?" text="Skip the reading. Tell us what you are weighing and we will give you a straight answer." cta="Book a Consultation" />
</Base>
