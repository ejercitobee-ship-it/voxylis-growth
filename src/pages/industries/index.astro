---
import Base from '../../layouts/Base.astro';
import IndustryCard from '../../components/IndustryCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { industries } from '../../data/industries';
---
<Base
  title="Industries We Serve | Voxylis Growth"
  description="Growth consulting for property management, e-commerce, technology and SaaS, professional services, education, and other growing US and UK businesses."
>
  <section>
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow" style="display:block;margin-bottom:0.8rem">Industries</span>
        <h1 style="font-size:clamp(2rem,4.5vw,3rem)">Different Industries. Shared Commitment to Excellence.</h1>
        <p>We work with businesses across many sectors. Property management and real estate is an early focus, but growth fundamentals travel, and we tailor the work to wherever your business is.</p>
      </div>
      <div class="grid cols-3" style="margin-top:2.8rem">
        {industries.map((i) => <IndustryCard ind={i} />)}
      </div>
    </div>
  </section>

  <CtaBand heading="Don't see your industry?" text="Growth fundamentals travel. Tell us about your business and we will tailor the right approach." cta="Book a Consultation" />
</Base>
